# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Claude API (Anthropic) — used by the AI companion (companion/ai_engine.py)
# claude-haiku-4-5 measured ~2.7s average for this call vs Opus 5's ~6s —
# closest to the PRD's <2s target and ~5x cheaper for a task this simple.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ElevenLabs (text-to-speech for the AI companion's message) — companion/tts.py
# Voice ID must come from YOUR account's GET /v1/voices — free-tier keys can't
# use every public-library voice ID via the API (some 402 "paid_plan_required").
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Web Push (VAPID) — generated in Phase 4, used for daily reminders + caregiver alerts
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# Crisis safety floor — swappable/localizable per companion/risk_rules.py
CRISIS_HOTLINE_TEXT=988 Suicide & Crisis Lifeline (call or text 988)
CRISIS_HOTLINE_NUMBER=988

# Live voice call (Pipecat) — voicecalls/ (Django) + voice_bot/ (standalone service)
DAILY_API_KEY=
DEEPGRAM_API_KEY=
# Where Django reaches the voice_bot service to start a bot for a call.
VOICE_SERVICE_URL=http://localhost:7860
# Shared secret used both directions: Django->voice_bot start-bot call, and
# voice_bot->Django completion webhook. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_SERVICE_SHARED_SECRET=
# Where voice_bot reaches Django's webhook.
DJANGO_BASE_URL=http://localhost:8000
MAX_CALL_DURATION_SECONDS=600
CRISIS_SCRIPTED_RESPONSE=I hear you, and I want you to know you don't have to go through this alone. If you're in crisis, please reach out right now: 988 Suicide & Crisis Lifeline, call or text 988. I'm going to stay on the line with you.
